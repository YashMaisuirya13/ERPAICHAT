{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "SecretKey": "SuperSecretKeyForErpAiChatJwtTokenSecurity2026!LongEnoughForHmacSha256",
    "Issuer": "ERP.ApiGateway",
    "Audience": "ERP.Services"
  },
  "ReverseProxy": {
    "Routes": {
      "inventory-base-route": {
        "ClusterId": "inventory-cluster",
        "CorsPolicy": "AllowFrontend",
        "Match": {
          "Path": "/api/inventory"
        }
      },
      "inventory-sub-route": {
        "ClusterId": "inventory-cluster",
        "CorsPolicy": "AllowFrontend",
        "Match": {
          "Path": "/api/inventory/{**catch-all}"
        }
      },
      "products-base-route": {
        "ClusterId": "inventory-cluster",
        "CorsPolicy": "AllowFrontend",
        "Match": {
          "Path": "/api/products"
        }
      },
      "products-sub-route": {
        "ClusterId": "inventory-cluster",
        "CorsPolicy": "AllowFrontend",
        "Match": {
          "Path": "/api/products/{**catch-all}"
        }
      },
      "suppliers-base-route": {
        "ClusterId": "supplier-cluster",
        "CorsPolicy": "AllowFrontend",
        "Match": {
          "Path": "/api/suppliers"
        }
      },
      "suppliers-sub-route": {
        "ClusterId": "supplier-cluster",
        "CorsPolicy": "AllowFrontend",
        "Match": {
          "Path": "/api/suppliers/{**catch-all}"
        }
      },
      "procurement-base-route": {
        "ClusterId": "procurement-cluster",
        "CorsPolicy": "AllowFrontend",
        "Match": {
          "Path": "/api/purchaseorders"
        }
      },
      "procurement-sub-route": {
        "ClusterId": "procurement-cluster",
        "CorsPolicy": "AllowFrontend",
        "Match": {
          "Path": "/api/purchaseorders/{**catch-all}"
        }
      },
      "ai-base-route": {
        "ClusterId": "ai-cluster",
        "CorsPolicy": "AllowFrontend",
        "Match": {
          "Path": "/api/ai"
        }
      },
      "ai-sub-route": {
        "ClusterId": "ai-cluster",
        "CorsPolicy": "AllowFrontend",
        "Match": {
          "Path": "/api/ai/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "inventory-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5045"
          }
        }
      },
      "supplier-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5046"
          }
        }
      },
      "procurement-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5047"
          }
        }
      },
      "ai-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5048"
          }
        }
      }
    }
  }
}
